{
  "version": 1,
  "cases": [
    {"name": "alice sees every demo tool",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "list": ["fake.echo", "fake.http_get", "fake.read_file", "fake.translate"],
     "expect": {"visible": ["fake.echo", "fake.http_get", "fake.read_file", "fake.translate"]}},
    {"name": "bob sees only echo",
     "subject": {"agent": "bob-bot"},
     "list": ["fake.echo", "fake.http_get", "fake.read_file", "fake.translate"],
     "expect": {"visible": ["fake.echo"]}},

    {"name": "alice reads a report",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.read_file", "arguments": {"path": "reports/q1.txt"}},
     "expect": {"decision": "allow", "rule": "read-workspace", "requires_approval": false}},
    {"name": "alice reads a note",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.read_file", "arguments": {"path": "notes/todo.md"}},
     "expect": {"decision": "allow", "rule": "read-workspace"}},
    {"name": "path traversal out of reports is refused with the reason",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.read_file", "arguments": {"path": "reports/../secrets/key"}},
     "expect": {"decision": "deny", "rule": "default-deny", "constraint_rule": "read-workspace",
                "reason_contains": "\"..\" segments", "hidden": false}},
    {"name": "a .env file is denied even inside reports",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.read_file", "arguments": {"path": "reports/.env"}},
     "expect": {"decision": "deny", "rule": "no-dotenv"}},
    {"name": "a top-level .env file is denied",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.read_file", "arguments": {"path": ".env"}},
     "expect": {"decision": "deny", "rule": "no-dotenv"}},
    {"name": "unknown arguments are refused",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.read_file", "arguments": {"path": "reports/q1.txt", "follow": true}},
     "expect": {"decision": "deny", "constraint_rule": "read-workspace"}},
    {"name": "bob cannot read files and is not told the tool exists",
     "subject": {"agent": "bob-bot"},
     "call": {"tool": "fake.read_file", "arguments": {"path": "reports/q1.txt"}},
     "expect": {"decision": "deny", "rule": "default-deny", "hidden": true}},

    {"name": "anyone may echo",
     "subject": {"agent": "bob-bot"},
     "call": {"tool": "fake.echo", "arguments": {"text": "hi"}},
     "expect": {"decision": "allow", "rule": "echo"}},
    {"name": "echo on an upstream no rule names is unknown",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "other.echo"},
     "expect": {"decision": "deny", "rule": "default-deny", "hidden": true}},

    {"name": "alice fetches from example.com",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.http_get", "arguments": {"url": "https://www.example.com/index.html"}},
     "expect": {"decision": "allow", "rule": "web-allowlist"}},
    {"name": "metadata address is refused",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.http_get", "arguments": {"url": "http://169.254.169.254/latest/meta-data/"}},
     "expect": {"decision": "deny", "constraint_rule": "web-allowlist", "reason_contains": "not in the allowed list"}},
    {"name": "user info in the URL is refused",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.http_get", "arguments": {"url": "https://example.com@evil.test/"}},
     "expect": {"decision": "deny", "constraint_rule": "web-allowlist"}},
    {"name": "bob may not fetch",
     "subject": {"agent": "bob-bot"},
     "call": {"tool": "fake.http_get", "arguments": {"url": "https://example.com/"}},
     "expect": {"decision": "deny", "hidden": true}},

    {"name": "translation waits for a human",
     "subject": {"agent": "alice-bot", "scopes": ["files:read"]},
     "call": {"tool": "fake.translate", "arguments": {"text": "hello", "to": "fr"}},
     "expect": {"decision": "allow", "rule": "translate-needs-approval", "requires_approval": true}},
    {"name": "bob may not translate",
     "subject": {"agent": "bob-bot"},
     "call": {"tool": "fake.translate", "arguments": {"text": "hello", "to": "fr"}},
     "expect": {"decision": "deny", "rule": "default-deny", "hidden": true}}
  ]
}
